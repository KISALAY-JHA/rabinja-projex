# RABINJA PROJEX — Environment Configuration
# Copy this file to .env.local to connect your Supabase PostgreSQL cloud backend:
# cp .env.example .env.local

# Supabase Project URL (from Supabase Dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (from Supabase Dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
